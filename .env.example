# Copy to .env or .env.local and fill in real values.
# Never commit real values.

# Database (PostgreSQL) - required
DATABASE_URL=postgresql://user:password@localhost:5432/database

# Cryptographic secrets - required in production
HMAC_SECRET=change-me
SESSION_SECRET=change-me

# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
APP_VERSION=3.0.0

# AI provider (optional unless AI features are used)
AI_API_KEY=
AI_API_KEY_ENCRYPTED=
AI_MODEL=
AI_BASE_URL=

# Web search (optional)
WEB_SEARCH_ENABLED=false
WEB_SEARCH_API_KEY=
WEB_SEARCH_CX=

# Security / networking
ALLOWED_ORIGINS=
CSP_SOURCES=
CLIENT_IP_SOURCE=

# Observability (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Alerts (optional)
ALERT_WEBHOOK_URL=

# Bootstrap
BOOTSTRAP_SETUP_TOKEN=

# Feature flags
RULE_PRECEDENCE_SHADOW_ENABLED=false

# Rule engine feature flags (runtime)
RULE_ENGINE_V2_ENABLED=false
RULE_ENGINE_ADAPTER_ENABLED=false
BANK_RULE_ENGINE=legacy
OPERATIONAL_POLICY_OBSERVATION_ENABLED=false
OPERATIONAL_POLICY_IMPORT_OBSERVATION_ENABLED=false
