{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "bash": {
      "*": "deny",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git ls-files*": "allow",

      "npm test": "allow",
      "npm run build": "allow",
      "npm run lint": "allow",

      "npx vitest *": "allow",
      "npx tsc *": "allow",
      "npx prisma *": "allow"
    },
    "task": "allow",
    "operation-controller-write": "allow"
  }
}