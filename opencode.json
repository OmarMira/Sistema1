{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "engram": {
      "type": "stdio",
      "command": "engram",
      "args": ["mcp", "--tools=agent"],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask"
    },
    "task": "allow",
    "operation-controller-write": "allow"
  }
}